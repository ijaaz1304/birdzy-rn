rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow anyone to read and write to posts folder (for public posts)
    match /posts/{postId}/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
