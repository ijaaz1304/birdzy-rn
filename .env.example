# ============================================
# Birdzy — Environment template
# Copy to .env.dev / .env.prod and fill in values.
# ============================================

# Bird API — host root ONLY (no /auth or /core suffix)
# App builds full URLs:
#   Auth → {API_BASE_URL}/auth/...
#   Core → {API_BASE_URL}/core/...
#
# Dev / staging:
#   BIRDS_API_BASE_URL=https://birds-api.trackzio.com
#   → Auth: https://birds-api.trackzio.com/auth
#   → Core: https://birds-api.trackzio.com/core
#
# Production (Shroom-style prod host — confirm with backend):
#   BIRDS_API_BASE_URL=https://birds-api-prod.trackzio.com

BIRDS_API_BASE_URL=https://birds-api.trackzio.com
API_BASE_URL=https://birds-api.trackzio.com
# Notification service (shared Trackzio host — dev and prod use the same URL)
# App is identified via x-app-code header:
#   Dev:  BirdsDev
#   Prod: Birds
NOTIFICATION_BASE_URL=https://notification-service.trackzio.com
APP_CODE=BirdsDev

# Google / Firebase — from Birdzy Firebase project
GOOGLE_WEB_CLIENT_ID=
GOOGLE_MAPS_API_KEY=

# Store listings
APP_STORE_ID=
PLAY_STORE_ID=com.trackzio.birds.dev

# Optional remote subscription pack JSON URL
SUBSCRIPTION_VALUE=

# Cross-promo apps list
PUBLISHED_APPS=https://progresspal-assets.s3.us-west-2.amazonaws.com/cross-promo-apps/list.json

# Geocoding
GEOCODING_API_BASE_URL=https://geocode.maps.co
GEOCODING_API_KEY=

# Legacy aliases (optional — BIRDS_API_BASE_URL / API_BASE_URL take precedence)
MUSHROOMS_API_BASE_URL=
MINERALS_API_BASE_URL=
