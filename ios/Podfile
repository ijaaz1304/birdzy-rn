require Pod::Executable.execute_command(
  'node',
  ['-p',
   'require.resolve(
     "react-native/scripts/react_native_pods.rb",
     { paths: [process.argv[1]] },
   )',
   __dir__
  ]
).strip

# react-native-permissions: must run before use_native_modules so RNPermissions has handlers
require_relative '../node_modules/react-native-permissions/scripts/setup'
setup_permissions([
  'Camera',
  'PhotoLibrary',
  'Notifications',
  'LocationWhenInUse',
  'Microphone',
])

# Remove requestAlwaysAuthorization from vendor sources before they are compiled.
# Apple ITMS-90683 scans the binary for Always APIs even when JS never requests them.
def strip_ios_always_location_apis!(_installer = nil)
  root = File.expand_path('..', __dir__)
  marker = 'ITMS-90683: Always location API removed'

  vision_camera = File.join(
    root,
    'node_modules/react-native-vision-camera/ios/Core/Extensions/CLLocationManager+requestAccess.swift'
  )
  if File.exist?(vision_camera)
    content = File.read(vision_camera)
    unless content.include?(marker)
      patched = content
        .gsub(/^\s*case always\n/, '')
        .gsub(
          /case \.always:\n\s*manager\.requestAlwaysAuthorization\(\)\n/,
          "// #{marker}\n"
        )
      if patched != content
        File.chmod(0644, vision_camera)
        File.write(vision_camera, patched)
        Pod::UI.puts '[Permissions] Stripped VisionCamera requestAlwaysAuthorization'
      end
    end
  end

  geolocation = File.join(
    root,
    'node_modules/@react-native-community/geolocation/ios/RNCGeolocation.mm'
  )
  if File.exist?(geolocation)
    content = File.read(geolocation)
    unless content.include?(marker)
      patched = content
        .gsub(
          /if \(wantsAlways\) \{\n#if !TARGET_OS_VISION\n\s*\[_locationManager requestAlwaysAuthorization\];\n\s*\[self enableBackgroundLocationUpdates\];\n#endif\n\s*\} else if \(wantsWhenInUse\) \{/,
          "// #{marker}\n  if (wantsWhenInUse) {"
        )
        .gsub(
          /\} else if \(_locationConfiguration\.authorizationLevel == RNCGeolocationAuthorizationLevelAlways\) \{\n\s*wantsAlways = YES;\n\s*\} else if/,
          "} else if"
        )
      if patched != content && !patched.include?('requestAlwaysAuthorization')
        File.chmod(0644, geolocation)
        File.write(geolocation, patched)
        Pod::UI.puts '[Permissions] Stripped geolocation requestAlwaysAuthorization'
      elsif patched != content
        # Fallback: comment out the selector call if structured replace partially failed
        fallback = content.gsub(
          '[_locationManager requestAlwaysAuthorization];',
          "// #{marker}\n    // [_locationManager requestAlwaysAuthorization];"
        ).gsub(
          '[self enableBackgroundLocationUpdates];',
          '// [self enableBackgroundLocationUpdates];'
        )
        File.chmod(0644, geolocation)
        File.write(geolocation, fallback)
        Pod::UI.puts '[Permissions] Commented geolocation Always location calls'
      end
    end
  end
end

strip_ios_always_location_apis!

# VisionCamera: do NOT compile CLLocation APIs. Identify location uses
# @react-native-community/geolocation (When In Use only). Leaving VisionCamera
# location enabled embeds requestAlwaysAuthorization and triggers ITMS-90683.
$VCEnableLocation = false

platform :ios, min_ios_version_supported

# Map custom build configurations so CocoaPods treats Debug-Dev as debug (required for
# Hermes inspector and RNWorklets linker symbols when building with Birdzy-Dev scheme).
project 'Birdzy', 'Debug' => :debug, 'Debug-Dev' => :debug, 'Release' => :release, 'Release-Dev' => :release

prepare_react_native_project!

# Required for Firebase + gRPC
use_modular_headers!

# Required for Firebase static frameworks
use_frameworks! :linkage => :static

# react-native-permissions: with use_frameworks!, force RNPermissions to build as static
# so permission handlers are correctly linked (fixes "No permission handler detected")
pre_install do |installer|
  installer.pod_targets.each do |pod|
    if pod.name.eql?('RNPermissions')
      def pod.build_type
        Pod::BuildType.static_library
      end
    end
  end
end

target 'Birdzy' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Firebase + Google Sign-In compatibility
  pod 'GTMSessionFetcher/Core', '~> 3.4'

  # AppDelegate registers SDImageWebPCoder for remote WebP (also via RNFastImage).
  pod 'SDWebImage', '~> 5.11.1'
  pod 'SDWebImageWebPCoder', '~> 0.8.4'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Xcode 15+ script sandbox can block [CP] Embed Pods Frameworks (hermes rsync/codesign).
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      end
    end
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.native_targets.each do |target|
        target.build_configurations.each do |build_config|
          build_config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
        end
      end
      aggregate_target.user_project.save
    end

    hermes_engine_dir = File.join(installer.sandbox.root, 'hermes-engine')
    if File.directory?(hermes_engine_dir)
      system('xattr', '-cr', hermes_engine_dir)
    end

    # Fix gRPC modulemap issues
    installer.pods_project.targets.each do |t|
      if t.name.start_with?('gRPC')
        t.build_configurations.each do |config|
          config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
        end
      end
    end

    # Xcode 26+ / Apple Clang: fmt 11.0.2 (bundled by RN) fails with
    # "call to consteval function 'fmt::basic_format_string' is not a constant expression".
    # Compile only fmt as C++17 so the consteval path is disabled; leave the rest on C++20.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'fmt'
      target.build_configurations.each do |build_config|
        build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      end
    end

    # Belt-and-suspenders: force FMT_USE_CONSTEVAL off in fmt 11.0.2 headers.
    # C++17 alone is usually enough; this covers cases where fmt still sees C++20 macros.
    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      content = File.read(fmt_base)
      unless content.include?('Xcode 26 workaround')
        patched = content.sub(
          /(#elif defined\(__cpp_consteval\)\n#\s*define FMT_USE_CONSTEVAL) 1/,
          "// Xcode 26 workaround: disable consteval\n\\1 0"
        )
        if patched != content
          File.chmod(0644, fmt_base)
          File.write(fmt_base, patched)
        end
      end
    end

    # Strip Always-location APIs from linked pods so App Store Connect does not
    # require NSLocationAlwaysAndWhenInUseUsageDescription (ITMS-90683).
    # App only uses When In Use via react-native-permissions + geolocation.
    strip_ios_always_location_apis!(installer)

    # Ensure Hermes inspector symbols are built for custom Debug configs (e.g. Debug-Dev).
    # RNWorklets references inspector_modern::RuntimeAdapter and chrome::enableDebugging/disableDebugging,
    # which are only compiled when HERMES_ENABLE_DEBUGGER=1. React Native only sets this for :debug type;
    # custom configs like "Debug-Dev" may not be treated as :debug, causing undefined symbol linker errors.
    hermes_debug_pods = %w[React-hermes hermes-engine React-RuntimeHermes]
    installer.pods_project.targets.each do |target|
      next unless hermes_debug_pods.include?(target.name)
      target.build_configurations.each do |build_config|
        next unless build_config.name.include?('Debug')
        definitions = build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
        definitions = definitions.is_a?(Array) ? definitions : (definitions ? definitions.to_s.split : [])
        definitions = ['$(inherited)'] if definitions.empty?
        definitions << 'HERMES_ENABLE_DEBUGGER=1' unless definitions.any? { |d| d.to_s.include?('HERMES_ENABLE_DEBUGGER') }
        build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = definitions
      end
    end
  end
end
