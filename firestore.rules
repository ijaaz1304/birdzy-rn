rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns a resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Posts collection (aligned with feed.service: userId, userName, likes, comments, shares)
    match /posts/{postId} {
      allow read: if true;
      
      allow create: if request.resource.data.userId is string
        && request.resource.data.userId != ''
        && request.resource.data.userName is string
        && request.resource.data.content is string
        && request.resource.data.createdAt != null
        && request.resource.data.likes is list
        && request.resource.data.comments is int
        && request.resource.data.shares is int;
      
      allow update: if request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.userName == resource.data.userName;
      
      // Delete: app only shows delete for own posts; allow delete so owner can delete (Firestore rules cannot verify backend JWT).
      allow delete: if true;

      // Comments subcollection (posts/{postId}/comments) - feed.service uses this path.
      // App uses backend-only auth (no Firebase Auth), so we allow create when payload shape is valid.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.userId is string
          && request.resource.data.userId != ''
          && request.resource.data.userName is string
          && request.resource.data.content is string
          && request.resource.data.createdAt != null
          && request.resource.data.likes is list;
        // Allow update for likes (and replyCount/updatedAt) without Firebase Auth; restrict other changes to owner when authenticated
        allow update: if (resource.data.userId == request.resource.data.userId
          && resource.data.userName == request.resource.data.userName
          && resource.data.content == request.resource.data.content
          && resource.data.createdAt == request.resource.data.createdAt
          && request.resource.data.likes is list)
          || (isAuthenticated() && resource.data.userId == request.auth.uid);
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

        // Replies subcollection (posts/{postId}/comments/{commentId}/replies)
        match /replies/{replyId} {
          allow read: if true;
          allow create: if request.resource.data.userId is string
            && request.resource.data.userId != ''
            && request.resource.data.userName is string
            && request.resource.data.content is string
            && request.resource.data.createdAt != null
            && request.resource.data.likes is list;
          allow update: if (resource.data.userId == request.resource.data.userId
            && resource.data.userName == request.resource.data.userName
            && resource.data.content == request.resource.data.content
            && resource.data.createdAt == request.resource.data.createdAt
            && request.resource.data.likes is list)
            || (isAuthenticated() && resource.data.userId == request.auth.uid);
          allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
        }
      }
    }
    
    // Legacy top-level comments collection (unused by feed.service; kept for backwards compatibility)
    match /comments/{commentId} {
      allow read: if true;
      
      allow create: if request.resource.data.authorId is string
        && request.resource.data.authorId != ''
        && request.resource.data.author is string
        && request.resource.data.content is string
        && request.resource.data.postId is string
        && request.resource.data.timestamp is int
        && request.resource.data.likeCount == 0
        && request.resource.data.likeList is list
        && request.resource.data.replyCount == 0;
      
      allow update: if request.resource.data.authorId == resource.data.authorId
        && request.resource.data.content is string;
      
      allow delete: if resource.data.authorId is string;
    }
    
    // Replies collection
    match /replies/{replyId} {
      allow read: if true;
      
      allow create: if request.resource.data.authorId is string
        && request.resource.data.authorId != ''
        && request.resource.data.author is string
        && request.resource.data.content is string
        && request.resource.data.commentId is string
        && request.resource.data.postId is string
        && request.resource.data.timestamp is int
        && request.resource.data.likeCount == 0
        && request.resource.data.likeList is list;
      
      allow update: if request.resource.data.authorId == resource.data.authorId
        && request.resource.data.content is string;
      
      allow delete: if resource.data.authorId is string;
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if true;
      
      allow create: if request.resource.data.userId is string
        && request.resource.data.userId != ''
        && request.resource.data.sourceUserId is string
        && request.resource.data.postId is string
        && request.resource.data.type is string
        && request.resource.data.timestamp is int
        && request.resource.data.read is bool;
      
      allow update: if request.resource.data.userId == resource.data.userId
        && resource.data.keys().hasAll(['read'])
        && request.resource.data.read is bool;
    }
    
    // Users collection (for bookmarks)
    match /users/{userId} {
      allow read: if true;
      
      allow create: if request.resource.data.bookmarkedPosts is list
        && request.resource.data.keys().hasOnly(['bookmarkedPosts']);
      
      allow update: if request.resource.data.bookmarkedPosts is list
        && request.resource.data.keys().hasOnly(['bookmarkedPosts'])
        && (!resource.exists || resource.data.keys().hasOnly(['bookmarkedPosts']));
    }
    
    // Hidden posts — app uses backend JWT (no Firebase Auth), so allow shape-validated writes.
    match /users/{userId}/feedPreferences/hidden {
      allow read: if true;
      allow create, update: if request.resource.data.hiddenPostIds is list;
      allow delete: if false;
    }

    // Posts reported by this user — used to filter their feed (own posts always remain visible).
    match /users/{userId}/feedPreferences/reported {
      allow read: if true;
      allow create, update: if request.resource.data.reportedPostIds is list;
      allow delete: if false;
    }

    // Other feed preferences (e.g. community rules) — Firebase Auth owner when available
    match /users/{userId}/feedPreferences/{docId} {
      allow read, write: if isOwner(userId);
    }

    // In-app feed notifications (like / comment / follow). App uses backend JWT without Firebase Auth for Firestore
    // (same model as posts/comments), so reads/writes are validated by shape — not by request.auth.
    match /users/{userId}/notifications/{notificationId} {
      allow read: if true;
      allow create: if request.resource.data.type is string
        && (request.resource.data.type == 'like'
            || request.resource.data.type == 'comment'
            || request.resource.data.type == 'follow')
        && request.resource.data.actorUserId is string
        && request.resource.data.actorUserId.size() > 0
        && request.resource.data.actorUserName is string
        && request.resource.data.createdAt is timestamp
        && (
          (request.resource.data.type == 'follow')
          || (request.resource.data.postId is string && request.resource.data.postId.size() > 0)
        );
      allow update, delete: if false;
    }

    // Followers: users/{authorId}/followers/{followerUserId} — optional doc for Follow action + notifications
    match /users/{userId}/followers/{followerId} {
      allow read: if true;
      allow create: if request.resource.data.createdAt is timestamp;
      allow delete: if true;
      allow update: if false;
    }
    
    // Reports collection (post reports for moderation)
    match /reports/{reportId} {
      allow create: if request.resource.data.postId is string
        && request.resource.data.reportedBy is string
        && request.resource.data.reportedBy.size() > 0;
      allow read, update, delete: if false;
    }
    
    // App config collection (for version checking)
    match /app_config/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
