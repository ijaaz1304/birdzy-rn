# ============================================
# Environment Variables - Development (Birdzy)
# ============================================

# Bird API — host root only (paths add /auth and /core in code)
# Auth: https://birds-api.trackzio.com/auth
# Core: https://birds-api.trackzio.com/core
BIRDS_API_BASE_URL=https://birds-api.trackzio.com
API_BASE_URL=https://birds-api.trackzio.com
# Notification service (shared — same URL dev + prod)
# Register device: POST https://notification-service.trackzio.com/device
# Header: x-app-code=BirdsDev
NOTIFICATION_BASE_URL=https://notification-service.trackzio.com
APP_CODE=BirdsDev

# Environment
ENV=development
APP_ENV=dev

# Google Services — Birdzy Firebase (Web client from google-services.json)
GOOGLE_WEB_CLIENT_ID=480281695791-0i90av2vb5o2uapt7lfs9dh7kbh0hd0j.apps.googleusercontent.com
GOOGLE_MAPS_API_KEY=

# Shared cross-promo list (common across Trackzio apps)
PUBLISHED_APPS=https://progresspal-assets.s3.us-west-2.amazonaws.com/cross-promo-apps/list.json

# App Store / Play Store — PENDING Birdzy store listings
APP_STORE_ID=
PLAY_STORE_ID=com.trackzio.birds.dev

# Subscription packs URL — PENDING Birdzy subscription configuration
SUBSCRIPTION_VALUE=

# Shared feedback API (common infrastructure)
RATING_FEEDBACK_API=https://msmnafgy53ptj4qqt3oqkk4gpe0pdtic.lambda-url.us-west-2.on.aws/

# App shared secret — PENDING Birdzy App Store Connect configuration
APP_SHARED_SECRET=

# Geocoding (common service)
GEOCODING_API_BASE_URL=https://geocode.maps.co
GEOCODING_API_KEY=

# Meta Install Referrer — PENDING Birdzy Meta App configuration
META_INSTALL_REFERRER_DECRYPTION_KEY=

# Birdzy Firebase configuration
FIREBASE_PROJECT_ID=birdzy-app-dev
FIREBASE_APP_ID=1:480281695791:android:a8c54e9b1f89b6c28958da
